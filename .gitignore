# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# 3D assets â€” see README "Replacing the placeholders"
# Binary .glb files do not diff or merge well. Preferred options, in order:
#   1. Commit the source scene (Spline project link in the README) and export
#      the .glb in CI or at build time.
#   2. Use Git LFS.
# Until one of those is set up, uncomment the line below to keep the repo
# light. The experience runs without them; the scene falls back to the
# procedural placeholders.
/public/models/*.glb

# ---------------------------------------------------------------------------
# Generated 3D assets
# ---------------------------------------------------------------------------
# public/assets/** is build output produced by:
#   npm run assets:build
# It is not committed. Binary .glb and .hdr files do not diff or merge, and
# the whole set is reproducible from scripts/fetch-assets.ts against a pinned
# asset list. Provenance — the part that genuinely needs version control —
# lives in docs/ASSETS.md and public/assets/README.md, both of which ARE
# committed.
/public/assets/**
!/public/assets/README.md

# Asset pipeline working directory. Raw Poly Haven downloads (237MB) and
# intermediate optimizer output. Regenerated by npm run assets:build.
/.cache/
